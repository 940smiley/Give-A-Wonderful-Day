# Give-A-Wonderful-Day environment template
# Copy to .env.local for local development. Never commit real secrets.

# ---------------------------------------------------------------------------
# Server-only: database and authentication
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/give_a_wonderful_day?schema=public"
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_DEV_EMAIL="admin@example.org"
ADMIN_DEV_PASSWORD="replace-with-a-long-development-password"
ENABLE_ADMIN_AUTOMATION="false"

# ---------------------------------------------------------------------------
# Public browser variables: safe to expose
# ---------------------------------------------------------------------------
NEXT_PUBLIC_NONPROFIT_CONTRACT_ADDRESS=""
NEXT_PUBLIC_EXPECTED_CHAIN_ID="11155111"
NEXT_PUBLIC_BLOCK_EXPLORER_URL="https://sepolia.etherscan.io"
NEXT_PUBLIC_DONATION_EVENT_BLOCK_WINDOW="5000"
NEXT_PUBLIC_MAX_DONATION_ETH="100"

# ---------------------------------------------------------------------------
# Server-only: blockchain operations and deployment
# ---------------------------------------------------------------------------
RPC_URL="https://sepolia.example.invalid"
DEPLOYER_PRIVATE_KEY=""
BLOCK_EXPLORER_API_KEY=""
TREASURY_ADDRESS=""
EXPECTED_CHAIN_ID="11155111"
CONTRACT_ADDRESS=""

# ---------------------------------------------------------------------------
# Server-only: AI draft provider
# ---------------------------------------------------------------------------
AI_PROVIDER="mock"
AI_API_KEY=""
AI_BASE_URL=""
AI_MODEL="mock-draft-v1"
AI_TIMEOUT_MS="15000"
AI_MAX_DAILY_REQUESTS="200"

# ---------------------------------------------------------------------------
# Server-only: email provider
# ---------------------------------------------------------------------------
EMAIL_PROVIDER="mock"
EMAIL_API_KEY=""
EMAIL_FROM="no-reply@example.org"

# ---------------------------------------------------------------------------
# Server-only: traditional donation provider
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER="mock"
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Server-only: scraping and platform
# ---------------------------------------------------------------------------
GRANT_SCRAPE_ALLOWED_DOMAINS=""
APP_BASE_URL="http://localhost:3000"
SENTRY_DSN=""

# ---------------------------------------------------------------------------
# Public browser variables: TON blockchain
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TON_MANIFEST_URL="https://yourapp.com/tonconnect-manifest.json"
NEXT_PUBLIC_TON_RECIPIENT_ADDRESS=""
NEXT_PUBLIC_TON_NETWORK="testnet"
NEXT_PUBLIC_TON_EXPLORER_URL="https://testnet.tonviewer.com"
