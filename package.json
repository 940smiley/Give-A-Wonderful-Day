{
  "name": "give-a-wonderful-day-dapp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "contract:compile": "hardhat compile",
    "contract:test": "hardhat test",
    "contract:coverage": "hardhat coverage",
    "contract:node": "hardhat node",
    "contract:deploy:testnet": "hardhat run scripts/deploy.ts --network sepolia",
    "contract:verify": "hardhat run scripts/verify.ts --network sepolia",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run contract:compile && npm run contract:test && npm run build",
    "check:release": "npm run check && npm run contract:coverage && npm run test:e2e && npm audit --omit=dev --audit-level=high",
    "postinstall": "node ./node_modules/prisma/build/index.js generate"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "1.0.7",
    "@openzeppelin/contracts": "5.6.1",
    "@prisma/client": "7.10.0",
    "@tonconnect/ui-react": "^3.0.2",
    "axios": "^1.20.0",
    "bcryptjs": "3.0.3",
    "ethers": "6.17.0",
    "ipaddr.js": "2.5.0",
    "next": "^16.3.3",
    "next-auth": "4.24.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "6.1.2",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/axios": "^0.14.4",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.5.4",
    "dotenv": "17.4.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "hardhat": "2.28.6",
    "jsdom": "30.0.1",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-solidity": "2.4.1",
    "prisma": "7.10.0",
    "solidity-coverage": "0.8.17",
    "tailwindcss": "3.4.19",
    "ts-node": "10.9.2",
    "tsx": "4.23.12",
    "typechain": "8.3.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "bn.js": "4.12.3",
    "cookie": "1.1.1",
    "js-yaml": "5.1.0",
    "lodash": "4.18.1",
    "postcss": "8.5.26",
    "serialize-javascript": "7.0.6",
    "tmp": "0.2.7",
    "undici": "6.27.0",
    "uuid": "11.1.1",
    "ws": "8.21.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
